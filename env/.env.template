# ============================================================================
# STUDENTUP — ENVIRONMENT CONFIG
# Copy to  env/.env  and fill in. Permissions:  chmod 600 env/.env
# The bot runs EVERYTHING offline without any of these (dry-run + offline
# question generator + curated content). These unlock live posting + AI.
# ============================================================================

# --- Telegram (required for live posting) -----------------------------------
# Get this from @BotFather
BOT_TOKEN=123456:ABC-YourBotTokenHere
# Your numeric Telegram id (for admin error alerts). Get from @userinfobot.
ADMIN_ID=

# Google Form link (optional) for detailed registration (phone/district/WhatsApp).
# Build it from forms/GOOGLE_FORM_BLUEPRINT.md, then paste the short link here.
FORM_URL=https://forms.gle/your-studentup-registration

# Channel targets. Use the numeric chat id (best, e.g. -1001234567890) OR the
# public @username. The bot MUST be an admin with "Post messages" in each.
# Leave unset to use the default @StudentUp<Name> usernames in core/config.py.
CHANNEL_TSPSC=@YourTSPSCchannel
CHANNEL_APPSC=@YourAPPSCchannel
CHANNEL_BANKING=@YourBankingChannel
CHANNEL_RAILWAY=@YourRailwayChannel
CHANNEL_POLICE=@YourPoliceChannel
CHANNEL_DEFENCE=@YourDefenceChannel
CHANNEL_SSC=@YourSSCchannel
CHANNEL_CURRENT=@YourCurrentChannel
CHANNEL_JOBS=-100YourPrivateJobsChannelId

# --- LLM keys (OPTIONAL — add as many as you have; EVERY key is rotated) ----
# Accepted forms: <PROVIDER>_KEY, <PROVIDER>_KEY_1.._N, <PROVIDER>_API_KEY(_N)
# Same value under two names is counted once (auto-merge).
# Rotation order on failure: Groq -> DeepSeek -> OpenAI -> Gemini -> Dify.
# Groq (workhorse, free tier) — console.groq.com
GROQ_KEY=gsk_...
GROQ_KEY_1=gsk_...
# Google Gemini (cold spare, unlimited keys) — aistudio.google.com
GEMINI_KEY_1=...
GEMINI_KEY_2=...
GEMINI_KEY_3=...
# GEMINI_API_KEY_1=...   (alias form — same value counted once)
# DeepSeek
DEEPSEEK_KEY=sk-...
# OpenAI
OPENAI_KEY=sk-proj-...
# Dify (extra provider via app token — e.g. DIFY.AI)
DIFY_APP_TOKEN=app-...

# --- Advanced web layer (optional) ------------------------------------------
# Jina Reader: automatic fallback when a site blocks plain scraping (r.jina.ai)
JINA_API_KEY=jina_...
# Parallel source discovery across the 500+ source registry (1 = serial).
# Per-host politeness still applies; parsing/dedup stays serial & exact.
COLLECT_WORKERS=6
# WhatsApp bridge (gateway/wa_bridge.js): localhost-only by default.
# Production meeda rendu process la ki SAME token ivvandi (bridge + dashboard).
# WA_BRIDGE_TOKEN=
# WA_BRIDGE_HOST=127.0.0.1
# 📱 Multi-number (250+ groups unte): okko number ki oka bridge process,
# URLs comma tho. Group registry lo "bridge" index tho sticky routing.
# WA_BRIDGE_URLS=http://127.0.0.1:3900,http://127.0.0.1:3901
# Serper.dev Google search: live URL discovery + deep source QA
SERPER_API_KEY=...
# WhatsApp broadcast mirror (display only)
WHATSAPP_CHANNEL=https://whatsapp.com/channel/...

# If every key fails the bot still works (offline generator + English/curated).

# --- Misc -------------------------------------------------------------------
# Set to 1 to force dry-run (never post) even on the server.
STUDENTUP_DRY=0

# --- Form auto-ingestion webhook (optional) ----------------------------------
# Run scripts/webhook_server.py on your public server and set these; paste the
# URL into forms/google_apps_script.gs (POST_WEBHOOK_URL) for zero-CSV signups.
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change-this-to-a-long-random-string


# ---- Poll presentation (advanced) ------------------------------------------
# Telugu-first layout for TS/AP aspirants (1=default on)
TELUGU_FIRST=1
# instant = Telegram ✅/❌ + explanation on every poll (default)
# delayed = withhold explanation; full bilingual answer-key posts at 08:00 / 20:00
ANSWER_MODE=instant
# Seconds a channel quiz poll stays open (Telegram open_period)
QUIZ_OPEN_PERIOD=300

# CRITICAL on server: replace YOUR_ID with your real Telegram numeric user id
# ADMIN_ID=YOUR_ID

# --- Public Website / Domain / AdSense (optional) ---------------------------
# Your public domain or subdomain, e.g. https://exam.yourdomain.com — all
# student links & QR codes will use this base. Leave empty to auto-detect.
PUBLIC_BASE_URL=
# Google AdSense (only PUBLIC pages show ads; exam pages never do).
# ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_SLOT_HOME=
# ADSENSE_SLOT_STUDY=
# PUBLIC_CONTACT_EMAIL=you@example.com

# Student Portal subdomain, e.g. https://quiz.studentup.in — students
# register once (name/mobile/district/exam goal) for Daily Quiz + Mocks.
# PORTAL_BASE_URL=https://quiz.studentup.in

# WordPress main site (blog master) for the /blog syndication bridge.
# WP_SITE_URL=https://studentup.in
