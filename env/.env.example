# 🚀 StudentUp — environment config
# Copy this file to env/.env and fill your real values:
#     cp env/.env.example env/.env

# 📢 Telegram bot token from @BotFather (lekapothe Telegram DRY-RUN lo untundi)
BOT_TOKEN=

# 🔑 Dashboard admin password (empty = data/dashboard_auth.json lo unna password)
DASHBOARD_PASSWORD=

# Ports (defaults fine for most servers)
DASHBOARD_PORT=5000
WA_BRIDGE_PORT=3900

# 🚨 Emergency: IP Lock valla lockout aite 1 pettandi (tarvata teeseyandi)
DISABLE_IP_LOCK=
