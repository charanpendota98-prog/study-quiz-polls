[Unit]
Description=StudentUp Form Webhook (Google Form -> members)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/studentup/scripts
ExecStart=/usr/bin/python3 /home/ubuntu/studentup/scripts/webhook_server.py
# WEBHOOK_PORT / WEBHOOK_SECRET come from env/.env (loaded by the
# app itself) — never hardcode a secret in this unit file.
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/studentup/logs/webhook.log
StandardError=append:/home/ubuntu/studentup/logs/webhook.log

[Install]
WantedBy=multi-user.target
