[Unit]
Description=StudentUp Interactive Bot (commands + leaderboard listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/studentup
ExecStart=/usr/bin/python3 /home/ubuntu/studentup/scripts/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/studentup/logs/bot.log
StandardError=append:/home/ubuntu/studentup/logs/bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
